# A4 scanner HTTP (system service)
# Install root (edit before copy, or run plotter-signature/deploy/ubuntu/configure-units.sh --scanner-only):
#   Meta repo:  /opt/Automated_Signature/a4-flating
#   Standalone:  /opt/a4-flating
[Unit]
Description=A4 Scanner HTTP Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diwan
Group=video
WorkingDirectory=/opt/Automated_Signature/a4-flating
Environment=PYTHONPATH=/opt/Automated_Signature/a4-flating
EnvironmentFile=/etc/default/a4-scanner
ExecStart=/opt/Automated_Signature/a4-flating/.venv/bin/python -m scanner_service
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
